	StaticText "the top, and fired bands fill in from above.", "gray"
	StaticText ""
	StaticText "Set the standing count to 8 and events have", "gold"
	StaticText "nowhere to go.", "gold"
	StaticText ""
	StaticText "STANDING -- the room has weather", "white"
