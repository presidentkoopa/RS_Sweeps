OptionMenu "RSSMain"
{
	Title "Sweeps"
	StaticText "Bands of light travelling through the world,", "gray"
	StaticText "tested per pixel against world position on every", "gray"
	StaticText "surface -- so one band wraps across floor, wall", "gray"
	StaticText "and ceiling as a single unbroken line. A sector's", "gray"
	StaticText "glow is uniform across that sector. This is not.", "gray"
	StaticText ""
	Option "Enabled", "rss_enabled", "OnOff"
	Option "Preset", "rss_preset", "RSS_Preset"
	StaticText "A preset sets the look and the motion. It never", "gold"
	StaticText "touches the switches on the Sources page.", "gold"
	StaticText ""
	Submenu "Sources -- what starts one", "RSSSources"
	Submenu "The Band", "RSSBand"
	Submenu "Colour", "RSSColor"
	Submenu "Lattice", "RSSFill"
	Submenu "Effects -- what a sweep DOES", "RSSFx"
}

OptionMenu "RSSSources"
{
	Title "Sources"
	StaticText "Three independent sources, because they are three", "gray"
