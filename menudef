	Option "On an explosion", "rss_ev_explode", "OnOff"
	Option "When YOU are hurt", "rss_ev_hurt", "OnOff"
	Slider "How many may hold at once", "rss_ev_slots", 0, 8, 1, 0
	Slider "Life, seconds", "rss_ev_life", 0.1, 5.0, 0.1, 1
	Slider "Reach", "rss_ev_reach", 128, 4096, 32, 0
	Slider "Speed", "rss_ev_speed", 0.1, 4.0, 0.05, 2
	Option "Shape", "rss_ev_shape", "RSS_Shape"
	StaticText "Pick a SWEEP shape and a kill sends one front", "gold"
	StaticText "across the rest of the map from where that", "gold"
	StaticText "monster was standing.", "gold"
}

