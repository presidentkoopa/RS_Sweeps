	Slider "Speed", "rss_ping_speed", 0.1, 3.0, 0.05, 2
	Slider "Reach", "rss_ping_reach", 128, 4096, 32, 0
	StaticText ""
	StaticText "FIRED -- the world answering you", "white"
	Option "On a kill", "rss_ev_kill", "OnOff"
	Option "  Bosses only", "rss_ev_bossonly", "OnOff"
	Slider "  ...or anything this big", "rss_ev_boss_health", 0, 6000, 100, 0
