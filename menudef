	StaticText "the order the wave arrives, rather than toggling", "gray"
	StaticText "everything at once with a light on top.", "gray"
	StaticText ""
	StaticText "Only bands that carry an effect pay for this.", "gold"
	StaticText ""
	Option "Enabled", "rss_fx", "OnOff"
	Option "Act on sectors", "rss_fx_sectors", "OnOff"
	Option "Act on actors", "rss_fx_actors", "OnOff"
	StaticText ""
